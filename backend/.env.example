APP_NAME=CyberShield
APP_ENV=production
DEBUG=False

DATABASE_URL=<postgresql-connection-string>

JWT_SECRET_KEY=<long-random-secret>
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

CORS_ORIGINS=https://your-frontend-domain.example
# Keep false for internet-facing deployments. Set true only for explicitly authorized private-network scanning.
ALLOW_PRIVATE_SCAN_TARGETS=False
# Optional real threat-intelligence provider
VIRUSTOTAL_API_KEY=
