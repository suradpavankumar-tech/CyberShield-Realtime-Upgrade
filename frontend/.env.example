# =========================================================
# CyberShield Frontend Environment
# =========================================================
#
# Development example:
# VITE_API_BASE_URL=http://127.0.0.1:8000/api/v1
#
# Production:
# Set this to the HTTPS URL of the deployed CyberShield API.
#
# IMPORTANT:
# Never put JWT secrets, database passwords, API private
# keys, or other server-side secrets in VITE_* variables.
#
# Vite exposes VITE_* variables to the browser.
# =========================================================

VITE_API_BASE_URL=http://127.0.0.1:8000/api/v1